{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  // فهرست سفید، عمداً — نه الگوی فراگیر `**/*.ts`.
  //
  // سرویس‌های ابری هنگام بیلد فایل‌ها را جابه‌جا می‌کنند. Dockerfile رانفلر
  // این خط را دارد:
  //     COPY package*.json prism[a] yarn.loc[k] /app/
  // و در Docker کپی کردن یک پوشه یعنی کپی شدن *محتوایش*. پس `prisma/seed.ts`
  // یک نسخه‌ی سرگردان در ریشه‌ی پروژه (`/app/seed.ts`) هم پیدا می‌کند که
  // ایمپورت نسبی‌اش (`../src/generated/...`) به بیرون پروژه اشاره می‌کند و
  // بیلد را با TS2307 می‌شکند — در حالی که محلی همه‌چیز سالم است.
  //
  // با فهرست سفید، فقط مسیرهای واقعی پروژه بررسی می‌شوند و هر فایل اضافه‌ای
  // که محیط بیلد در ریشه بریزد نادیده گرفته می‌شود.
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "prisma7.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "prisma/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
