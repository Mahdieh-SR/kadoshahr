# ─────────────────────────────────────────────────────────────
#  این فایل «نمونه» است و به گیت commit می‌شود.
#  یک کپی از آن با نام `.env` بسازید و مقادیر واقعی را در آن بگذارید.
#  فایل `.env` هرگز نباید commit شود (در .gitignore قرار دارد).
# ─────────────────────────────────────────────────────────────

# دیتابیس PostgreSQL
#
# روی سرور (رانفلر): رشته‌ی اتصال «داخلی» دیتابیس پروژه. چون ترافیک از شبکه‌ی
# داخلی رد می‌شود، پارامتر sslmode لازم ندارد:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
#
# روی دیتابیس ابری بیرونی (مثل Neon) که از اینترنت وصل می‌شوید، SSL لازم است
# و باید `verify-full` باشد نه `require` — رفتار امروزِ درایور pg همین است و
# نوشتن صریحش هشدار SECURITY WARNING را هم می‌بندد:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# کلید رمزنگاری کوکی‌های ورود.
# برای ساختن یک کلید جدید در ترمینال بزنید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="یک-رشته-تصادفی-اینجا-بگذارید"

# آدرس پایه‌ی سایت. در حالت توسعه همین مقدار درست است.
# موقع انتشار روی سرور، آدرس دامنه‌ی واقعی را بگذارید: https://example.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# حالت نمایش — فقط برای دموی موقت به کارفرما.
# وقتی true باشد، کد تایید روی صفحه نشان داده می‌شود و یک نوار هشدار
# بالای سایت ظاهر می‌شود.
# ⛔ پیش از افتتاح واقعی فروشگاه حتماً حذف یا false شود.
DEMO_MODE="false"

# ─── درگاه پرداخت زرین‌پال ───
# ZARINPAL_MODE مقدارهای مجاز:
#   mock    -> درگاه ساختگی برای تست (بدون نیاز به هیچ کلیدی)
#   sandbox -> محیط تست زرین‌پال
#   live    -> درگاه واقعی
ZARINPAL_MODE="mock"

# مرچنت‌آیدی ۳۶ کاراکتری زرین‌پال (از پنل zarinpal.com > درگاه‌های پرداخت)
# تا وقتی ZARINPAL_MODE=mock است، این مقدار استفاده نمی‌شود.
ZARINPAL_MERCHANT_ID=""

# ─── پنل پیامک (فعلاً غیرفعال) ───
# تا وقتی SMS_PROVIDER=console باشد، کد تایید فقط در ترمینال چاپ می‌شود
# و در حالت توسعه روی صفحه هم نشان داده می‌شود.
SMS_PROVIDER="console"
SMS_API_KEY=""
SMS_SENDER=""
SMS_TEMPLATE=""
